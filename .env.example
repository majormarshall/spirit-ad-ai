# =============================================================================
# SPIRIT AD AI — Environment Variables Template
# Copy this file to .env.local and fill in your actual values.
# NEVER commit .env.local to source control.
# =============================================================================

# -----------------------------------------------------------------------------
# SUPABASE
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# -----------------------------------------------------------------------------
# OPENAI
# -----------------------------------------------------------------------------
OPENAI_API_KEY=sk-...

# Model to use for text generation (e.g. gpt-4o, gpt-4-turbo, gpt-3.5-turbo)
OPENAI_MODEL=gpt-4o

# Model to use for image generation (dall-e-3 or dall-e-2)
OPENAI_IMAGE_MODEL=dall-e-3

# AI confidence threshold (0-100). Below this, escalate to human.
AI_CONFIDENCE_THRESHOLD=60

# -----------------------------------------------------------------------------
# META (Facebook & Instagram)
# -----------------------------------------------------------------------------
META_APP_ID=your-meta-app-id
META_APP_SECRET=your-meta-app-secret

# Comma-separated scopes requested during Facebook OAuth
META_SCOPES=pages_show_list,pages_read_engagement,pages_manage_posts,instagram_basic,instagram_content_publish

# -----------------------------------------------------------------------------
# WHATSAPP BUSINESS
# -----------------------------------------------------------------------------
WHATSAPP_ACCESS_TOKEN=your-whatsapp-access-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_BUSINESS_ACCOUNT_ID=your-business-account-id
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your-random-webhook-verify-token

# -----------------------------------------------------------------------------
# APPLICATION
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Used to sign server-side JWTs and other internal tokens
APP_SECRET=your-random-app-secret-min-32-chars

# Cron job secret — sent as Authorization header to protect cron routes
CRON_SECRET=your-random-cron-secret

# Default timezone for scheduled jobs
APP_TIMEZONE=Africa/Lagos
